<%- include('../partials/header') %>
<main>
  <h1>Boat Admin Panel</h1>

  <% if (success) { %>
    <div class="alert alert-success">
      <%= success %>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <div class="admin-container">
    <div class="add-boat-section">
      <h2>Add New Boat Listing</h2>
      <form method="POST" action="/admin/add-boat" class="admin-form">
        <div class="form-group">
          <label for="title">Boat Title *</label>
          <input type="text" id="title" name="title" required placeholder="e.g., Centurion Ri245">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="make">Make</label>
            <input type="text" id="make" name="make" placeholder="e.g., Centurion">
          </div>

          <div class="form-group">
            <label for="model">Model</label>
            <input type="text" id="model" name="model" placeholder="e.g., Ri245">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="year">Year</label>
            <input type="number" id="year" name="year" placeholder="2026" min="1900" max="2100">
          </div>

          <div class="form-group">
            <label for="price">Price</label>
            <input type="number" id="price" name="price" placeholder="185000" min="0" step="0.01">
          </div>
        </div>

        <div class="form-group">
          <label for="condition">Condition *</label>
          <select id="condition" name="condition" required>
            <option value="">-- Select --</option>
            <option value="new">New</option>
            <option value="used">Used</option>
          </select>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="5" placeholder="Describe the boat, its features, and condition..."></textarea>
        </div>

        <div class="form-group">
          <label>Images</label>
          <div id="imageInputsContainer">
            <div class="image-input-row">
              <input type="url" name="image_urls" placeholder="https://example.com/image1.jpg" class="image-url-input">
              <button type="button" class="btn-remove-image">Remove</button>
            </div>
          </div>
          <button type="button" class="btn-add-more-images">+ Add Another Image</button>
        </div>

        <button type="submit" class="btn-submit">Add Boat Listing</button>
      </form>
    </div>

    <div class="boats-list-section">
      <h2>Existing Boats</h2>
      <% if (boats && boats.length > 0) { %>
        <div class="boats-table">
          <div class="table-header">
            <div class="col-title">Title</div>
            <div class="col-year">Year</div>
            <div class="col-price">Price</div>
            <div class="col-condition">Condition</div>
            <div class="col-actions">Actions</div>
          </div>
          <% boats.forEach(boat => { %>
            <div class="table-row">
              <div class="col-title"><%= boat.title %></div>
              <div class="col-year"><%= boat.year || 'N/A' %></div>
              <div class="col-price"><%= boat.price ? '$' + parseFloat(boat.price).toLocaleString() : 'N/A' %></div>
              <div class="col-condition"><span class="<%= boat.condition %>"><%= boat.condition.charAt(0).toUpperCase() + boat.condition.slice(1) %></span></div>
              <div class="col-actions">
                <a href="/admin/edit/<%= boat.id %>" class="btn-edit">Edit</a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p>No boats in inventory yet.</p>
      <% } %>
    </div>
  </div>

  <script src="/js/admin.js" defer></script>
</main>
<%- include('../partials/footer') %>
