<%- include('../partials/header') %>
<main>
  <% if (status === 404) { %>
    <div style="text-align: center; padding: 40px 20px;">
      <img src="/images/404-error.webp" alt="404 Page Not Found" style="max-width: 100%; height: auto; max-height: 400px; object-fit: contain; margin-bottom: 30px;">
      <h1 style="color: #003d7a; margin-bottom: 15px;">Page Not Found</h1>
      <p style="font-size: 16px; color: #666; margin-bottom: 30px;">The page you're looking for doesn't exist.</p>
      <a href="/" style="display: inline-block; background-color: #003d7a; color: white; padding: 12px 30px; text-decoration: none; border-radius: 4px; font-weight: 600;">Return Home</a>
    </div>
  <% } else { %>
    <h1>Something went wrong</h1>
    <h2><%= message %></h2>

    <% if (error && error.stack) { %>
      <pre style="background-color: #f5f5f5; padding: 15px; border-radius: 4px; overflow-x: auto;"><%= error.stack %></pre>
    <% } %>

    <a href="/">Return Home</a>
  <% } %>
</main>
<%- include('../partials/footer') %>
