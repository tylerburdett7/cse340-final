<link rel="stylesheet" href="/css/style.css" />
<link rel="stylesheet" href="/css/login.css" />

<header>
  <img src="/images/fredslogo.png" alt="Fred's Marine Logo" class="header-logo">
  <nav>
    <a href="/">Home</a>
    <a href="/boats">Boat Inventory</a>
    <% if (isLoggedIn) { %>
      <% if (userRole === 'customer') { %>
        <a href="/service-request">Request Service</a>
        <a href="/my-requests">My Requests</a>
      <% } %>
      <% if (userRole === 'admin' || userRole === 'sales_rep') { %>
        <a href="/add-listing">Sales</a>
      <% } %>
      <% if (userRole === 'admin' || userRole === 'service_manager') { %>
        <a href="/admin/service-requests">Service Requests</a>
      <% } %>
      <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
      <a href="/register">Register</a>
    <% } %>
  </nav>
</header>
