<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Error</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>Something went wrong</h1>
  <h2><%= message %></h2>

  <% if (error && error.stack) { %>
    <pre><%= error.stack %></pre>
  <% } %>

  <a href="/">Return Home</a>
</body>
</html>
